# Adapter flavor: static | cloudflare | vercel | netlify | node | bun
ADAPTER=static

# GitHub Pages project site (set by actions/configure-pages in CI)
# BASE_PATH=/sveltekit-fonts-playground

# Optional deploy tokens (never required for `pnpm build`)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# RAILWAY_TOKEN=
# RAILWAY_SERVICE=
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
