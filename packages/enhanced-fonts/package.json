{
	"name": "@sveltejs/enhanced-fonts",
	"version": "0.1.0",
	"description": "Experimental self-hosted fonts for Svelte and SvelteKit apps",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fringe4life/sveltekit-fonts-playground.git",
		"directory": "packages/enhanced-fonts"
	},
	"keywords": [
		"component",
		"enhanced",
		"font",
		"fonts",
		"plugin",
		"svelte",
		"sveltekit",
		"vite"
	],
	"license": "MIT",
	"homepage": "https://svelte.dev/docs/kit",
	"type": "module",
	"scripts": {},
	"files": [
		"src",
		"types"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/index.js"
		},
		"./Font.svelte": {
			"types": "./src/Font.svelte.d.ts",
			"svelte": "./src/Font.svelte",
			"default": "./src/Font.svelte"
		},
		"./package.json": "./package.json"
	},
	"types": "types/index.d.ts",
	"dependencies": {
		"unifont": "^1.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"svelte": "^5.57.1",
		"vite": "^8.2.1"
	},
	"peerDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.0.0",
		"vite": ">=8.0.12"
	},
	"engines": {
		"node": ">=22"
	}
}
